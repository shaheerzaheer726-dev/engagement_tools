# Used by the dashboard, worker, Prisma, and pg-boss.
DATABASE_URL=postgresql://engagement:engagement@localhost:5432/engagement_tools

# Required only when creating the initial administrator with `pnpm db:seed`.
# Choose a unique password of 12-72 UTF-8 bytes. Do not commit the real value.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=

# Dashboard
NEXT_PUBLIC_APP_NAME=Engagement Tools
PORT=3000

# Worker
WORKER_HEALTH_PORT=3001
WORKER_CONCURRENCY=5
