{
  "name": "engagement-tools",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "dev": "pnpm --filter @engagement-tools/database build && turbo dev",
    "dev:dashboard": "pnpm --filter @engagement-tools/database build && pnpm --filter @engagement-tools/dashboard dev",
    "dev:worker": "pnpm --filter @engagement-tools/database build && pnpm --filter @engagement-tools/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && turbo typecheck",
    "db:generate": "pnpm --filter @engagement-tools/database generate",
    "db:migrate:deploy": "pnpm --filter @engagement-tools/database migrate:deploy",
    "db:migrate": "pnpm --filter @engagement-tools/database migrate:dev",
    "db:studio": "pnpm --filter @engagement-tools/database studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
